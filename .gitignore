# secrets -- never tracked
.env
.env.*

# deploy artifacts -- fully regenerated by publish.py / Vercel CLI;
# holds the .env.local token, project IDs, and the mirror URL
publish/

# runtime state -- regenerated by the pipeline
state/
digest/
__pycache__/
*.pyc

# generated outputs -- regenerated by backtest.py / explore scripts
backtest/
explore/data/
explore/charts/
explore/corpus.html

# regenerated per-recipient; embeds the mirror URL
rollout/*.pdf
